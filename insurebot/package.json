{
  "name": "insurebot",
  "version": "0.1.0",
  "description": "Multi-tenant MCP server for insurance agencies (security learning project)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/telemetry.js dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "security:lockfile": "node scripts/check-lockfile.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "docker run --rm -v \"$PWD/..:/repo\" ghcr.io/gitleaks/gitleaks:v8.28.0 git /repo --redact --no-banner",
    "security:shadow-scan": "tsx scripts/shadow-mcp-scan.ts",
    "security:tool-manifest": "tsx scripts/tool-manifest.ts",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "attack-report": "tsx scripts/attack-report.ts"
  },
  "type": "module",
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.13.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
