REDIS_URL=redis://127.0.0.1:6381
HOST=127.0.0.1
PORT=3001
QUOTE_TTL_SECONDS=1800
LEGACY_MODE=stateless
OIDC_ISSUER=http://localhost:8080/realms/insurebot
OIDC_INTERNAL_URL=http://localhost:8080/realms/insurebot
RESOURCE_URL=http://localhost:3000/mcp
# Step 04. Generate each secret with:  openssl rand -base64 48
PAYCO_URL=http://127.0.0.1:4000
PAYCO_API_KEY=
REQUEST_STATE_KEY=
# Step 06. Generate with: openssl rand -hex 24
INSUREBOT_APP_PASSWORD=
DATABASE_URL=postgres://insurebot_app:<INSUREBOT_APP_PASSWORD>@127.0.0.1:5432/insurebot
# Step 07
SMTP_URL=smtp://127.0.0.1:1025
RATE_LIMIT_PER_MINUTE=600
# Step 10: PDP (Cedar + AuthZEN). Generate with: openssl rand -base64 48
PDP_URL=http://127.0.0.1:8181
PDP_API_KEY=
# Lab UI. UI_OIDC_CLIENT_SECRET = the insurebot-ui client secret in Keycloak; LAB_VIEWER_PASSWORD: openssl rand -hex 24
UI_OIDC_CLIENT_SECRET=
LAB_VIEWER_PASSWORD=
